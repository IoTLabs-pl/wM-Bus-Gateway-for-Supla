{
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "v26.8+ needs ESP-IDF 6 (mbedTLS 4), which ESPHome and wmbus_common do not support yet",
      "matchPackageNames": ["SUPLA/supla-device"],
      "allowedVersions": "<26.8"
    }
  ],
  "customManagers": [
    {
      "managerFilePatterns": ["wmbus_gateway.yaml"],
      "fileFormat": "yaml",
      "customType": "jsonata",
      "matchStrings": [
        "($re := \/^github:\\\/\\\/([^\/]+\\\/[^\/]+)\\\/.*@([^@\/]+)$\/;packages.{\"packageName\": $replace(wmbus_gateway, $re, \"$1\"),\"currentValue\": $replace(wmbus_gateway, $re, \"$2\")})"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "managerFilePatterns": ["wmbus_gateway.yaml"],
      "fileFormat": "yaml",
      "customType": "jsonata",
      "matchStrings": ["supla_device.{ \"currentValue\": version }"],
      "packageNameTemplate": "SUPLA/supla-device",
      "datasourceTemplate": "github-releases"
    }
  ]
}
